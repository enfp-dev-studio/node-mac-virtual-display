{
  "name": "node-mac-virtual-display",
  "version": "1.0.16",
  "description": "A Native module to create and handle virtual display on macOS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "gypfile": true,
  "scripts": {
    "build": "npm run build:ts && node-gyp rebuild",
    "build:ts": "tsc",
    "clean": "node-gyp clean",
    "rebuild:electron": "npm --prefix examples/electron run rebuild",
    "test:electron": "npm --prefix examples/electron run test",
    "lint": "clang-format --dry-run -Werror ./src/virtual_display.mm && prettier --check src/index.ts",
    "format": "clang-format -i ./src/virtual_display.mm && prettier --write src/index.ts",
    "test": "mocha --reporter spec",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enfp-dev-studio/node-mac-virtual-display.git"
  },
  "author": "ENFP-Dev-Studio",
  "license": "MIT",
  "devDependencies": {
    "@types/bindings": "^1.5.5",
    "@types/node": "^25.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "chai": "^6.2.2",
    "clang-format": "^1.8.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mocha": "^11.8.0",
    "node-gyp": "^12.2.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^8.5.0"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ],
    "*.mm": [
      "clang-format -i"
    ]
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "8.0.3"
  }
}
